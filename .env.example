# Copy to .env and edit. Never commit .env.
# WRDS user name. The password is read from ~/.pgpass by the wrds library, never from here.
WRDS_USERNAME=
# Root directory for cache/, imports/ and runs/
BACKBONE_DATA_DIR=data
BACKBONE_USER_PLUGINS_DIR=user_plugins
BACKBONE_HOST=127.0.0.1
BACKBONE_PORT=8000
BACKBONE_FRONTEND_ORIGIN=http://127.0.0.1:5173
# Hot-reload user_plugins/ when files change
BACKBONE_DEV_MODE=true
BACKBONE_LOG_LEVEL=INFO
BACKBONE_DEFAULT_CALENDAR=XNYS
BACKBONE_MAX_WORKERS=2
BACKBONE_DEFAULT_BENCHMARK=SPY
